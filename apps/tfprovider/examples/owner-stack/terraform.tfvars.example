# Copy to terraform.tfvars and fill in your real values (the copy is
# gitignored — this directory's .gitignore). The FluxVale PAT does NOT
# go in this file: export FLUXVALE_PAT instead (README.md).

# Staging rehearsal: https://staging.fluxvale.com (with a staging PAT)
api_url = "https://fluxvale.com"

cloudflare_api_token  = "REPLACE_ME_CLOUDFLARE_API_TOKEN"
cloudflare_account_id = "REPLACE_ME_CLOUDFLARE_ACCOUNT_ID"
r2_bucket_name        = "fluxvale-backups" # any name unique in the account
r2_access_key_id      = "REPLACE_ME_R2_ACCESS_KEY_ID"
r2_secret_access_key  = "REPLACE_ME_R2_SECRET_ACCESS_KEY"

tailnet_domain     = "REPLACE-ME.ts.net" # the tailnet's MagicDNS suffix
tailscale_auth_key = "REPLACE_ME_TAILSCALE_AUTH_KEY"

# The instances, keyed by name (= the backups prefix). The default
# three below are the skeleton's representative shapes — override the
# whole map to differ. version null = track the catalog's newest; pin
# to freeze (a version change replaces the instance). Sizes: catalog
# classes are micro 0.25/512, small 0.5/512, medium 0.5/1024,
# standard 1.0/2048, plus 2.0/4096, pro 4.0/8192.
instances = {
  forgejo = { app = "forgejo", version = null, cpu_cores = 1.0, memory_mb = 1024, storage_gb = 5, exposure = "public", always_on = true, running = true, retention_keep = 14, domain = null }
  memos   = { app = "memos", version = null, cpu_cores = 0.25, memory_mb = 512, storage_gb = 5, exposure = "private", always_on = false, running = true, retention_keep = null, domain = null }
  kavita  = { app = "kavita", version = null, cpu_cores = 0.5, memory_mb = 512, storage_gb = 10, exposure = "private", always_on = false, running = true, retention_keep = null, domain = null }

  # Dogfood pairings, pending the dogfood plan (domains, OIDC, money
  # gates are decided there). Real domain names — they stay commented
  # so an apply registers nothing until that plan lands: set forgejo's
  # domain on the row above and uncomment umami (in the catalog).
  # forgejo … domain = "git.fluxvale.com"
  # umami = { app = "umami", version = null, cpu_cores = 0.5, memory_mb = 512, storage_gb = 5, exposure = "public", always_on = true, running = true, retention_keep = null, domain = "analytics.fluxvale.com" }
}
