<Layouts.auth flash={@flash}>
  <div class="bg-brand-gradient rounded-panel p-2 shadow-lg">
    <div class="overflow-hidden rounded-panel border border-line-strong bg-panel shadow-sm">
      <div class="space-y-5 p-6 sm:p-8" data-testid="oauth-device-code">
        <div class="space-y-1.5">
          <p class="text-xs font-medium uppercase tracking-wide text-ink-subtle">
            Device verification
          </p>
          <h1 class="text-2xl font-bold tracking-tight text-ink">
            Enter your device code
          </h1>
          <p class="text-sm leading-6 text-ink-muted">
            Enter the code shown in your terminal for <span class="font-mono text-xs text-ink">{@signed_in_as}</span>.
          </p>
        </div>

        <form
          action={~p"/oauth/device"}
          method="get"
          class="space-y-4"
          data-testid="oauth-device-code-form"
        >
          <.input
            id="user_code"
            name="user_code"
            type="text"
            label="Device code"
            placeholder="XXXX-XXXX"
            autocomplete="off"
            autocapitalize="characters"
            spellcheck="false"
            required
            autofocus
            class="font-mono text-center text-lg uppercase tracking-widest"
            data-testid="oauth-device-code-input"
          />
          <.button type="submit" class="w-full" data-testid="oauth-device-code-submit">
            Continue
          </.button>
        </form>
      </div>
    </div>
  </div>
</Layouts.auth>
