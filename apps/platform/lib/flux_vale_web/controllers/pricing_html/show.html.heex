<Layouts.public flash={@flash} current_user={@current_user}>
  <%!-- #440: the calculator IS the pricing surface — resource sliders
  in, one curve-priced total out (PikaPods pattern). No sizes table, no
  tier labels: prices follow resources, and the same slider state costs
  the same for every app. The billing copy band and the CTA band stay
  as shipped. Mobile: the calculator card stacks by construction. --%>
  <div class="space-y-10">
    <div class="space-y-2">
      <h1 class="text-3xl font-semibold tracking-tight text-ink">{gettext("Pricing")}</h1>
      <p class="max-w-2xl text-ink-muted">
        {gettext(
          "Prices follow the resources an app gets, not the app itself. Any app with the same resources costs the same."
        )}
      </p>
    </div>

    <%!-- The interactive calculator (#440): a controller-embedded child
    LiveView — SSR'd here in place, so crawlers see the formed state.
    The :id pins the child's DOM identity for reconnects; the conn
    session rides the embed (Static.render merges it), which the child
    uses only to re-resolve the locale in mount. The capped width keeps
    the centerpiece focused against the page's max-w-5xl column. --%>
    <section id="calculator" data-testid="pricing-calculator-slot" class="mx-auto max-w-3xl">
      {live_render(@conn, FluxValeWeb.PricingCalculatorLive, id: "pricing-calculator")}
    </section>

    <section aria-labelledby="billing-title" class="space-y-4">
      <h2 id="billing-title" class="text-lg font-semibold tracking-tight text-ink">
        {gettext("How billing works")}
      </h2>
      <%!-- Prose mirror of sweep_zero_balance.ex's ladder — its window
      constants are private module attributes with no public reader, so
      a ladder change must update this copy by hand. --%>
      <.card class="space-y-4" data-testid="pricing-billing-model">
        <p class="text-sm leading-relaxed text-ink-muted">
          {gettext(
            "You pay with prepaid credits. One credit is one US cent, and every rate above is a monthly equivalent billed hourly from your credit balance. There are no subscriptions."
          )}
        </p>
        <p class="text-sm leading-relaxed text-ink-muted">
          {gettext(
            "New accounts start with %{amount} in credits.",
            amount: Pricing.format_usd(@welcome_grant_cents)
          )}
        </p>
        <p class="text-sm leading-relaxed text-ink-muted">
          {gettext(
            "When your credit balance runs out, your apps stop running and their charges stop with them. Stopped apps keep their storage fee, and a balance left negative for 30 days deletes your data. We email warnings 7 days and 1 day before."
          )}
        </p>
      </.card>
    </section>

    <.card class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
      <div>
        <h2 class="text-lg font-semibold tracking-tight text-ink">
          {gettext("Start in minutes")}
        </h2>
        <p class="text-sm text-ink-muted">
          {gettext("Pick an app from the catalog and run it with the resources you choose.")}
        </p>
      </div>
      <div class="flex flex-wrap gap-3">
        <.button navigate={~p"/catalog"}>{gettext("Browse apps")}</.button>
        <.button navigate={~p"/sign-in"} variant="ghost">{gettext("Get started")}</.button>
      </div>
    </.card>
  </div>
</Layouts.public>
