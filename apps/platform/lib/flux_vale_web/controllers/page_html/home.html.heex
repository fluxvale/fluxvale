<%!-- Self-contained landing page: its own header/footer, no phx-* attributes
— plain server-rendered HEEx for a fast first paint. Session logic stays
display-only (#205): the template branches on @current_user for the chrome
(user menu, dashboard CTA) but the anonymous render is unchanged. The landing
is also mounted at /about — canonical to / — so signed-in sessions keep a
path to it once / becomes the dashboard.
Copy lives in gettext — the msgid is the source of truth; the wording is
reviewed at merge (#164). Not extracted: standalone proper nouns
(FluxVale, Forgejo, Kavita), and the aria-hidden mock status panel
(.panel) — decorative, never read, so its contents stay literal.
/catalog hrefs can move to ~p now that the route registers (router.ex)
— left literal here pending that slice's cleanup.
The Offset grammar (#277): four-layer offset hero (sunken circle wash, status
panel, float chip, display headline), uneven bento steps with the real
catalog preview, full-bleed catalog + pricing bands with a straddling
honesty capsule, load/scroll reveals + hover lifts in landing.css. The
whole content wraps in .landing.contents — display:contents keeps this
layout's flex contract while scoping the landing styles. --%>

<div class="landing contents">
  <Layouts.flash_group flash={@flash} />

  <header class="sticky top-0 z-40 border-b border-line bg-canvas/80 backdrop-blur dark:border-line-strong">
    <div class="wrap flex h-14 items-center justify-between gap-4">
      <a href={~p"/"} aria-label="FluxVale" class="flex w-fit items-center gap-2.5">
        <img
          src={~p"/images/mark.svg"}
          width="28"
          height="28"
          alt=""
          aria-hidden="true"
          class="dark:hidden"
        />
        <img
          src={~p"/images/mark-dark.svg"}
          width="28"
          height="28"
          alt=""
          aria-hidden="true"
          class="hidden dark:block"
        />
        <span class="text-sm font-semibold tracking-tight text-ink">FluxVale</span>
      </a>
      <nav aria-label={gettext("Primary")}>
        <ul class="flex items-center gap-2">
          <li class="hidden min-[480px]:block"><.nav_link href="/catalog">{gettext("Apps")}</.nav_link></li>
          <li class="hidden min-[480px]:block"><.nav_link href="/blog">{gettext("Blog")}</.nav_link></li>
          <li :if={is_nil(@current_user)}>
            <.button href={~p"/sign-in"} size="sm">
              {gettext("Sign in")} <span aria-hidden="true">&rarr;</span>
            </.button>
          </li>
          <li :if={@current_user}>
            <%!-- #285 T4: handle + PRIMARY address, mirror fallback (see
            User.primary_email) — same contract as the app chrome's menu. --%>
            <.user_menu
              username={@current_user.username}
              email={@current_user.primary_email || @current_user.email}
            />
          </li>
        </ul>
      </nav>
    </div>
  </header>

  <main class="flex-1">
    <%!-- Hero: four calm layers — the sunken circle wash (z0, parallax
    slowest), the status panel (z1, offset right+down), the deploy chip
    (z1.5, below-left of the hero box), the display headline (z2). The
    panel is a decorative mock (aria-hidden); the float chip repeats the
    wiki row as visible mono text. The overlap exists only >=900px
    (landing.css). --%>
    <section class="hero">
      <div class="wrap">
        <div class="hero-grid">
          <div class="hero-circle px-slow" aria-hidden="true"></div>

          <div class="hero-copy">
            <p class="eyebrow rise">{gettext("Managed hosting")}</p>
            <h1 class="display rise d1">
              {gettext("Managed hosting for open source applications")}
            </h1>
            <p class="hero-sub rise d2">
              {gettext(
                "Pick an open source app, deploy it in minutes, and FluxVale keeps it running — updates and monitoring included."
              )}
            </p>
            <div class="hero-ctas rise d3">
              <.button href="/catalog" class="lift">
                {gettext("Browse apps")}
              </.button>
              <.button
                :if={is_nil(@current_user)}
                href={~p"/sign-in"}
                variant="ghost"
                size="lg"
              >
                {gettext("Sign in")}
              </.button>
              <.button
                :if={@current_user}
                href={~p"/"}
                variant="ghost"
                size="lg"
              >
                {gettext("Your dashboard")}
              </.button>
            </div>
          </div>

          <div class="hero-panel rise d2">
            <div class="px-panel">
              <div class="panel" aria-hidden="true">
                <div class="panel-bar">
                  <span class="dots"><i></i><i></i><i></i></span>
                  <span class="path">app.fluxvale.app</span>
                  <span>&nbsp;</span>
                </div>
                <div class="rows">
                  <div class="row">
                    <span class="chip">GB</span>
                    <span class="who">
                      <span class="name">ghostboard</span>
                      <span class="meta">Running v2.4.1</span>
                    </span>
                    <span class="badge badge-live"><i></i>Live</span>
                  </div>
                  <div class="row">
                    <span class="chip">WK</span>
                    <span class="who">
                      <span class="name">wiki</span>
                      <span class="meta">Rolling out v1.1</span>
                    </span>
                    <span class="badge badge-deploy"><i></i>Deploying</span>
                  </div>
                  <div class="row">
                    <span class="chip">FM</span>
                    <span class="who">
                      <span class="name">forum</span>
                      <span class="meta">Update to v3.0 ready</span>
                    </span>
                    <span class="badge badge-ready"><i></i>Update ready</span>
                  </div>
                </div>
              </div>
            </div>
            <%!-- Outside .px-panel on purpose: its parallax transform
            would trap the chip on the panel (see landing.css). --%>
            <div class="float-chip drop d5">
              <span class="dot"></span>{gettext("wiki · rolling out v1.1")}
            </div>
          </div>
        </div>
      </div>
    </section>

    <%!-- How it works: uneven bento — the tall cell carries the real
    catalog preview (two entries + the catalog link). --%>
    <section aria-labelledby="how-it-works-title" class="steps">
      <div class="wrap">
        <div class="band-head">
          <p class="eyebrow reveal">{gettext("How it works")}</p>
          <h2 id="how-it-works-title" class="display-h2 reveal">
            {gettext("Three steps to a running app")}
          </h2>
        </div>
        <div class="bento">
          <div class="cell tall reveal">
            <span class="n">01</span>
            <h3>{gettext("Pick an app")}</h3>
            <p>
              {gettext("Choose from a curated catalog of open source applications, ready to run.")}
            </p>
            <div class="mini">
              <span class="cat">{gettext("Developer Tools")}</span>
              <div class="m">
                <span class="chip">FJ</span>
                <span>
                  <b>Forgejo</b>
                  <span class="d">{gettext(
                    "Self-hosted Git forge with issues, pull requests, and Actions CI"
                  )}</span>
                </span>
              </div>
              <span class="cat">{gettext("Media & Entertainment")}</span>
              <div class="m">
                <span class="chip">KV</span>
                <span>
                  <b>Kavita</b>
                  <span class="d">{gettext(
                    "Self-hosted digital library for comics, manga, and ebooks"
                  )}</span>
                </span>
              </div>
              <div class="foot">
                <span class="more">{gettext("…and more in the catalog")}</span>
                <a href="/catalog" class="arrowlink">
                  {gettext("Browse apps")} <span class="arrow" aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </div>
          <div class="cell raised reveal">
            <span class="n">02</span>
            <h3>{gettext("Deploy")}</h3>
            <p>
              {gettext("One guided flow from app to live URL — no YAML, no servers to babysit.")}
            </p>
          </div>
          <div class="cell raised reveal">
            <span class="n">03</span>
            <h3>{gettext("We run it")}</h3>
            <p>
              {gettext("Updates and monitoring are on us. Your data stays yours.")}
            </p>
          </div>
        </div>
      </div>
    </section>

    <%!-- App catalog band: full-bleed panel-raised seam; the second
    card rides offset-down at >=900px. --%>
    <section aria-labelledby="catalog-title" class="catalog-band">
      <div class="wrap catalog-in">
        <div class="band-head reveal">
          <p class="eyebrow">{gettext("App catalog")}</p>
          <h2 id="catalog-title" class="display-h2">
            {gettext("One click from browse to a running instance")}
          </h2>
        </div>
        <div class="catalog-cards">
          <div class="app-card reveal">
            <p class="cat">{gettext("Developer Tools")}</p>
            <div class="app">
              <span class="chip">FJ</span>
              <b>Forgejo</b>
            </div>
            <p>{gettext("Self-hosted Git forge with issues, pull requests, and Actions CI")}</p>
          </div>
          <div class="app-card offset-down reveal">
            <p class="cat">{gettext("Media & Entertainment")}</p>
            <div class="app">
              <span class="chip">KV</span>
              <b>Kavita</b>
            </div>
            <p>{gettext("Self-hosted digital library for comics, manga, and ebooks")}</p>
          </div>
        </div>
        <div class="catalog-cta reveal">
          <.button href="/catalog" class="lift">
            {gettext("Browse apps")}
          </.button>
        </div>
      </div>
    </section>

    <%!-- Pricing: sunken band; the honesty capsule straddles the seam
    (#277 pattern). --%>
    <section aria-labelledby="pricing-title" class="pricing-band">
      <div class="wrap">
        <div class="capsule-slot drop d5">
          <span class="capsule">
            <span class="dot"></span>
            {gettext(
              "Every app runs on FluxVale's own managed Kubernetes fleet — the same infrastructure we run ourselves on."
            )}
          </span>
        </div>
        <div class="pricing-in">
          <div>
            <h2 id="pricing-title" class="reveal">
              {gettext("One flat rate, no surprises")}
            </h2>
            <p class="sub reveal">
              {gettext(
                "Pay per app and size, month to month. New accounts start with welcome credits; top up when you're ready."
              )}
            </p>
          </div>
          <div class="pricing-side reveal">
            <span class="eyebrow">{gettext("Simple pricing")}</span>
            <.button href="/catalog" class="lift">
              {gettext("See the apps and prices")}
            </.button>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="wrap foot-in">
      <span class="foot-brand">
        <a href={~p"/"} aria-label="FluxVale" class="flex items-center gap-2.5">
          <img
            src={~p"/images/mark.svg"}
            width="22"
            height="22"
            alt=""
            aria-hidden="true"
            class="dark:hidden"
          />
          <img
            src={~p"/images/mark-dark.svg"}
            width="22"
            height="22"
            alt=""
            aria-hidden="true"
            class="hidden dark:block"
          />
        </a>
        <span>{gettext("© %{year} FluxVale", year: Date.utc_today().year)}</span>
      </span>
      <nav aria-label={gettext("Footer")}>
        <ul class="foot-links">
          <li><a href="/catalog">{gettext("Apps")}</a></li>
          <li><a href="/blog">{gettext("Blog")}</a></li>
          <li :if={is_nil(@current_user)}>
            <a href={~p"/sign-in"}>{gettext("Sign in")}</a>
          </li>
          <li :if={@current_user}>
            <a href={~p"/"}>{gettext("Dashboard")}</a>
          </li>
        </ul>
      </nav>
    </div>
  </footer>
</div>
