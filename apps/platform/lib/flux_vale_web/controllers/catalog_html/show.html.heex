<Layouts.public flash={@flash} current_user={@current_user} return_to={@return_to}>
  <%!-- #611 (plan §6.3-6.4): the hero (S2), the curated sections
  (S4), then the S3 generated sections in plan order — benefits, FAQ,
  similar apps, closing CTA — each seam a border-t with the lane's py
  rhythm. The curated sections self-omit when unauthored (plan §5), so
  an app without screenshots or features gets no gap. --%>
  <div class="catalog-page">
    <div class="pt-6 pb-12">
      <CatalogPageComponents.hero
        app={@app}
        newest_version={@newest_version}
        wake_estimates={@wake_estimates}
      />
    </div>

    <CatalogPageComponents.in_action app={@app} />
    <CatalogPageComponents.features app={@app} />
    <CatalogPageComponents.benefits app={@app} newest_version={@newest_version} />
    <CatalogPageComponents.faq app={@app} newest_version={@newest_version} />
    <CatalogPageComponents.similar_apps
      peers={@similar_apps}
      from_price_cents={@from_price_cents}
    />
    <CatalogPageComponents.closing_cta app={@app} newest_version={@newest_version} />
  </div>

  <%!-- Structured data for crawlers (#164, ADR-00025 §3): rendered
  server-side. The controller encodes with Jason's :html_safe mode, so
  raw/1 cannot break out of the script block. HEEx does not interpolate
  curly expressions inside script bodies — percent-bracket it is. --%>
  <script type="application/ld+json" id="ld-json-app">
    <%= raw(@json_ld) %>
  </script>
</Layouts.public>
