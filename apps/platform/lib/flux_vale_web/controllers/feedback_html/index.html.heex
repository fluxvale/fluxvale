<%!-- Board index (#412 T4, tags T10, composer CTA T5): the public
feature-request list on the public chrome — sort tabs, status and tag
filter chips, one linked row per post with its tag chips, offset pager,
and the header CTA into the composer (the islands slice; the composer
itself carries the honest anonymous/gate states). --%>
<Layouts.public flash={@flash} current_user={@current_user}>
  <div class="space-y-8">
    <.header>
      Feedback
      <:subtitle>
        Tell us what to build next. Every post is public and tracked by the team.
      </:subtitle>
      <%!-- #412 T9: the board/roadmap tabs — the view switch both
      public feedback surfaces carry (the component lives in
      FeedbackHTML, shared with the roadmap page). T5 adds the composer
      CTA beside them: the write is reachable from the surface it
      belongs to, not just by URL. Anonymous and ineligible visitors
      see it too — the composer renders their honest states. --%>
      <:actions>
        <.lane_tabs current={:board} />
        <.button navigate={~p"/feedback/new"} data-testid="composer-cta">
          {gettext("Post a request")}
        </.button>
      </:actions>
    </.header>

    <div class="space-y-3">
      <%!-- Every control carries the whole view state: a flip of sort or
      status keeps an active tag filter (and the tag chips keep
      sort/status), so a filtered view never silently resets. --%>
      <div class="flex items-center gap-1 rounded-control border border-line bg-panel p-1 text-sm">
        <.link
          href={board_href("top", @status, 1, @tag && @tag.slug)}
          aria-current={@sort == "top" && "page"}
          class={[
            "rounded-[calc(var(--radius-control)-0.25rem)] px-3 py-1.5 font-medium transition-colors duration-(--motion-fast)",
            @sort == "top" && "bg-primary-muted text-link",
            @sort != "top" && "text-ink-muted hover:text-ink"
          ]}
        >
          Top
        </.link>
        <.link
          href={board_href("new", @status, 1, @tag && @tag.slug)}
          aria-current={@sort == "new" && "page"}
          class={[
            "rounded-[calc(var(--radius-control)-0.25rem)] px-3 py-1.5 font-medium transition-colors duration-(--motion-fast)",
            @sort == "new" && "bg-primary-muted text-link",
            @sort != "new" && "text-ink-muted hover:text-ink"
          ]}
        >
          Newest
        </.link>
      </div>

      <div class="flex flex-wrap items-center gap-2" aria-label="Filter by status">
        <.link
          href={board_href(@sort, nil, 1, @tag && @tag.slug)}
          aria-current={is_nil(@status) && "true"}
          class={[
            "rounded-full border px-3 py-1 text-xs font-medium transition-colors duration-(--motion-fast)",
            is_nil(@status) && "border-primary/25 bg-primary-muted text-link",
            not is_nil(@status) && "border-line bg-panel text-ink-muted hover:text-ink"
          ]}
        >
          All
        </.link>
        <.link
          :for={status <- status_options()}
          href={board_href(@sort, status, 1, @tag && @tag.slug)}
          aria-current={@status == status && "true"}
          class={[
            "rounded-full border px-3 py-1 text-xs font-medium transition-colors duration-(--motion-fast)",
            @status == status && "border-primary/25 bg-primary-muted text-link",
            @status != status && "border-line bg-panel text-ink-muted hover:text-ink"
          ]}
        >
          {status_label(status)}
        </.link>
      </div>

      <%!-- The tag filter (T10) rides the same view state: chips list the
      tags in use, an active chip toggles off, and sort/status ride
      along (the other controls carry the tag in turn). Hidden until at
      least one post is tagged (prod launches with an empty vocabulary
      and nothing to show). --%>
      <div
        :if={@tags_in_use != []}
        class="flex flex-wrap items-center gap-2"
        aria-label="Filter by tag"
      >
        <.link
          :for={tag <- @tags_in_use}
          href={
            board_href(
              @sort,
              @status,
              1,
              if(tag_chip_active?(tag, @tag), do: nil, else: tag.slug)
            )
          }
          aria-current={tag_chip_active?(tag, @tag) && "true"}
          data-testid={"feedback-tag-chip-#{tag.slug}"}
          class={[
            "rounded-full border px-3 py-1 text-xs font-medium transition-colors duration-(--motion-fast)",
            tag_chip_active?(tag, @tag) && "border-primary/25 bg-primary-muted text-link",
            !tag_chip_active?(tag, @tag) && "border-line bg-panel text-ink-muted hover:text-ink"
          ]}
        >
          {tag.name}
        </.link>
      </div>
    </div>

    <div class="space-y-3">
      <.link
        :for={post <- @posts}
        href={~p"/feedback/#{post.slug}"}
        id={"feedback-post-#{post.slug}"}
        data-testid={"feedback-post-#{post.slug}"}
        class="group block rounded-panel border border-line bg-panel p-5 transition-[border-color,box-shadow] duration-(--motion-base) ease-(--motion-ease-out) hover:border-line-strong hover:shadow-sm"
      >
        <div class="flex items-start justify-between gap-4">
          <h2 class="min-w-0 text-base font-semibold text-ink transition-colors duration-(--motion-fast) group-hover:text-link [overflow-wrap:anywhere]">
            {post.title}
          </h2>
          <.feedback_status_badge status={post.status} />
        </div>
        <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-muted">
          <span>{status_changed_label(post)}</span>
          <span class="flex items-center gap-1.5">
            <.icon name="hero-hand-thumb-up" class="size-4" />
            {count_label(post.vote_count, "vote")}
          </span>
          <span class="flex items-center gap-1.5">
            <.icon name="hero-chat-bubble-oval-left-ellipsis" class="size-4" />
            {count_label(post.comment_count, "comment")}
          </span>
        </div>
        <%!-- Display-only chips (T10): the row is one link, so these stay
        plain spans here and link only on the post page. --%>
        <div :if={post.tags != []} class="mt-2 flex flex-wrap items-center gap-1.5">
          <.feedback_tag_chip :for={tag <- post.tags} tag={tag} />
        </div>
      </.link>
    </div>

    <.empty_state :if={@posts == []} title={empty_title(@status, @tag)} />

    <nav :if={@total_pages > 1} aria-label="Pagination" class="flex items-center justify-between">
      <.link
        :if={@page > 1}
        href={board_href(@sort, @status, @page - 1, @tag && @tag.slug)}
        class="text-sm font-medium text-link hover:underline"
      >
        &larr; Previous
      </.link>
      <span class="text-sm text-ink-muted">Page {@page} of {@total_pages}</span>
      <.link
        :if={@page < @total_pages}
        href={board_href(@sort, @status, @page + 1, @tag && @tag.slug)}
        class="text-sm font-medium text-link hover:underline"
      >
        Next &rarr;
      </.link>
    </nav>
  </div>
</Layouts.public>
