<%!-- Post page (#412 T4 + T5): the request detail on the public
chrome. Status badge carries the status-changed age, duplicates get the
merged-into banner. The interactive layer mounts as live_render islands
(T5, ADR-0026 S4): the vote island (count + cast/retract) and the
comments island (list + form) — both SSR their initial render, so the
document stays crawlable. --%>
<Layouts.public flash={@flash} current_user={@current_user}>
  <article class="mx-auto w-full max-w-2xl">
    <.button variant="ghost" size="sm" navigate={~p"/feedback"} class="-ml-2 mb-4">
      &larr; Feedback
    </.button>

    <div
      :if={@post.status == :duplicate}
      id="duplicate-banner"
      class="mb-6 rounded-panel border border-line-warning bg-warning-muted px-4 py-3 text-sm text-ink"
    >
      This request is a duplicate of
      <.link
        href={~p"/feedback/#{@post.duplicate_of.slug}"}
        data-testid="duplicate-original-link"
        class="font-medium underline decoration-line-strong underline-offset-2 hover:text-link"
      >
        {@post.duplicate_of.title}
      </.link>
      and is kept for the record.
    </div>

    <header class="space-y-3">
      <div class="flex flex-wrap items-center gap-3">
        <.feedback_status_badge status={@post.status} />
        <p class="text-sm text-ink-muted">{status_changed_label(@post)}</p>
      </div>
      <h1 class="text-balance text-3xl font-semibold tracking-tight text-ink [overflow-wrap:anywhere]">
        {@post.title}
      </h1>
      <%!-- Tag chips (T10): each links to the board filtered by the tag;
      a chip whose slug matches a catalog app rides the /apps/:slug
      cross-link below (the display convention). --%>
      <div
        :if={@post.tags != []}
        data-testid="post-tags"
        class="flex flex-wrap items-center gap-2"
      >
        <.feedback_tag_link :for={tag <- @post.tags} tag={tag} />
      </div>
      <div
        :if={app_linked_tags(@post.tags, @app_slugs) != []}
        class="flex flex-wrap items-center gap-x-4 gap-y-1"
      >
        <.feedback_app_link :for={tag <- app_linked_tags(@post.tags, @app_slugs)} tag={tag} />
      </div>
    </header>

    <%!-- The vote island: count + cast/retract, branched on the shared
    gate predicate (T5). The session token rides so the child resolves
    the actor display-only. --%>
    {live_render(
      @conn,
      FluxValeWeb.FeedbackLive.VoteIsland,
      id: "feedback-vote-island-#{@post.id}",
      session: %{"user_token" => @user_token, "slug" => @post.slug}
    )}

    <div class="mt-6">
      <%!-- pre-line rides the span: the p's own whitespace stays normal,
      so the template's indentation newlines collapse (the catalog
      poster's rule). The body is plain text with real line breaks. --%>
      <p class="leading-relaxed text-ink">
        <span class="whitespace-pre-line">{String.trim(@post.description)}</span>
      </p>
    </div>

    <%!-- The comments island: list + form, any signed-in actor may
    comment (the owner's Nov ruling), anonymous reads. --%>
    {live_render(
      @conn,
      FluxValeWeb.FeedbackLive.CommentsIsland,
      id: "feedback-comments-island-#{@post.id}",
      session: %{"user_token" => @user_token, "slug" => @post.slug}
    )}
  </article>
</Layouts.public>
