# Dev image for the local k3d/Tilt stack (ADR-0020) — runs `mix phx.server`,
# NOT a release: that delta is exactly what staging verifies later.
#
# The full base-image tag arrives as a build-arg from the Tiltfile, which
# also asserts it matches mise.toml's BEAM pins (single source of truth —
# hexpm appends rebuild suffixes like `erlang-28.5.0.6`, so the tag can't
# be composed from mise.toml alone; the assertion catches drift instead).
# Base is precompiled — no OTP source compile.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# git: mix fetches heroicons/daisyui as git deps. make/gcc/musl-dev:
# bcrypt_elixir (hard dep of ash_authentication) is a portable C NIF —
# needs the toolchain at deps.compile. picosat_elixir was the musl-broken
# NIF and is gone in favor of simple_sat (see mix.exs), but the toolchain
# stays for bcrypt and any future NIFs.
RUN apk add --no-cache git make gcc musl-dev

# Unprivileged runtime user (created here, activated below — after the
# build steps, so chown covers everything the reloader must write)
RUN adduser -D -u 10001 dev

WORKDIR /app

ENV MIX_ENV=dev

# Deps layer: cached unless the lockfile changes
COPY mix.exs mix.lock ./
RUN mix deps.get

# Compile deps without the app (app source syncs in via live_update)
RUN mix deps.compile

# App source — the layer live_update replaces
COPY lib lib
COPY priv priv
COPY assets assets
COPY config config

# Tailwind pre-seed (#230): CI stages the exact binary
# `mix tailwind.install --if-missing` looks for — tailwind-<target>-
# <version> under _build/, the path tailwind-elixir computes — into
# .tw-cache/ in the build context (actions/cache + curl; the in-image
# fetch dies on httpc's 10KB header limit, #230). Locally and in the
# nightly the dir holds only .gitkeep: default fetch path unchanged.
COPY .tw-cache/ /app/_build/

# esbuild/tailwind binaries + initial asset build (Hex-managed, no Node)
RUN mix assets.setup && mix assets.build

# Dev is no excuse for root (review finding): /app stays writable by dev
# for the code reloader's in-container compiles. Hex/rebar install to the
# dev user's HOME — the root-installed copies under /root aren't visible
# after USER switches.
RUN chown -R dev:dev /app
USER dev
RUN mix local.hex --force && mix local.rebar --force

EXPOSE 4000

CMD ["mix", "phx.server"]
